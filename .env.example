# Fill in the keys for the providers you want to use. Never commit the real .env file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override each provider's default model (the -m flag still wins).
CLAUDE_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# --- Hosting (see docs/HOSTING.md). Leave empty to keep the single-user local version. ---
# Postgres (Supabase) for the bank, quizzes and settings. Run `pnpm db:migrate` once after setting it.
DATABASE_URL=
# 32+ random characters; encrypts saved API keys. Never change it once people have saved keys.
SETTINGS_SECRET=
# Google sign-in through Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the site, e.g. https://sheetloop.app (where Google sends people back to).
SITE_URL=
# Cloudflare R2 for uploads, page images and figures.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Storage each account may use once sign-in is on, in MB (default 1024).
STORAGE_QUOTA_MB=
# Address shown on /privacy for account deletion requests.
SUPPORT_EMAIL=
