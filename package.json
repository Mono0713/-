{
  "name": "exam-bank",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @exam/web dev",
    "start": "pnpm --filter @exam/web start",
    "preview": "pnpm --filter @exam/web build && pnpm --filter @exam/web start",
    "extract": "pnpm --filter @exam/cli start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "i18n": "pnpm --silent --filter @exam/web i18n"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
